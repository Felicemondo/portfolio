---
import Base from '../layouts/Base.astro';
import ProjectDetail from './ProjectDetail.astro';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import type { Lang, Project } from '../data/profile.ts';
import { profile, projects } from '../data/profile.ts';
import { ui, href, homePath, projectPath } from '../lib/i18n.ts';

interface Props {
  p: Project;
  lang: Lang;
}
const { p, lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'it' ? 'en' : 'it';
const i = projects.indexOf(p);
const more = [1, 2, 3].map((n) => projects[(i + n) % projects.length]);
const ask = lang === 'it' ? 'Ti serve qualcosa di simile? Scrivimi.' : 'Need something like this? Email me.';
---

<Base
  lang={lang}
  title={`${p.client}: ${p.title[lang]} · ${profile.name}`}
  description={p.summary[lang]}
  path={projectPath(lang, p.slug)}
  altPath={projectPath(other, p.slug)}
>
  <div class="page">
    <nav class="bar">
      <a class="ghost" href={href(homePath(lang))}><Icon name="back" size={16} />{t.back}</a>
      <a class="ghost" href={href(projectPath(other, p.slug))} hreflang={other} lang={other}><Icon name="globe" size={16} />{t.langSwitch}</a>
    </nav>
    <main>
      <ProjectDetail p={p} lang={lang} headingLevel="h1" />
      <div class="cta a-sky">
        <p>{ask}</p>
        <a class="btn btn-primary" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />{profile.email}</a>
      </div>
      <h2>{t.otherWork}</h2>
      <div class="more">
        {more.map((m) => <ProjectCard p={m} lang={lang} />)}
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    max-width: 820px;
    margin: var(--space-6) auto;
    padding: 0 var(--space-4) var(--space-10);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  main {
    padding: clamp(var(--space-5), 4vw, var(--space-10));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-8) 0;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 500;
  }
  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
  }
</style>
