---
import type { Lang } from '../data/profile.ts';
import { profile, projects } from '../data/profile.ts';
import { clientData, replies } from '../data/intents.ts';
import { ui, href, homePath, projectPath } from '../lib/i18n.ts';
import Blocks from './Blocks.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'it' ? 'en' : 'it';
const cv = profile.cv || profile.links.linkedin;

const menu = [
  { id: 'about', icon: 'user', accent: 'violet' },
  { id: 'now', icon: 'spark', accent: 'lime' },
  { id: 'projects', icon: 'grid', accent: 'coral' },
  { id: 'experience', icon: 'briefcase', accent: 'sky' },
  { id: 'film', icon: 'film', accent: 'pink' },
  { id: 'education', icon: 'cap', accent: 'sun' },
] as const;
const starters = ['about', 'projects', 'experience', 'contact'] as const;
const starterIcon = { about: 'user', projects: 'grid', experience: 'briefcase', contact: 'mail' } as const;
const starterAccent = { about: 'violet', projects: 'coral', experience: 'sky', contact: 'lime' } as const;
const firstChips = ['now', 'film', 'skills', 'hire'];

const data = {
  ...clientData(lang),
  urls: Object.fromEntries(projects.map((p) => [p.slug, href(projectPath(lang, p.slug))])),
  firstChips,
  typing: t.typing,
};
const greeting = lang === 'it' ? 'Ciao, sono Felice.' : 'Hi, I’m Felice.';
---

<a class="skip" href="#ask">{t.skip}</a>
<div class="desk">
  <div class="window" data-app>
    <header class="titlebar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="url">felicemondo.it</span>
      <div class="actions">
        <button type="button" class="ghost" data-new aria-label={t.newChat}><Icon name="plus" size={16} /><span>{t.newChat}</span></button>
        <a class="ghost" href={href(homePath(other))} hreflang={other} lang={other} aria-label={t.langSwitch}><Icon name="globe" size={16} /><span>{t.langSwitch}</span></a>
      </div>
    </header>

    <div class="body">
      <aside class="sidebar">
        <div class="me">
          <div class="avatar" aria-hidden="true">FM</div>
          <div>
            <p class="name">{profile.name}</p>
            <p class="muted">{profile.role[lang]}</p>
          </div>
        </div>
        <p class="status"><i></i>{profile.available[lang]}</p>

        <nav aria-label={t.ask} class="menu">
          <p class="label">{t.ask}</p>
          {
            menu.map((m) => (
              <button type="button" data-ask={m.id} class={`a-${m.accent}`}>
                <span class="ico">
                  <Icon name={m.icon} size={16} />
                </span>
                {replies[m.id].label[lang]}
              </button>
            ))
          }
        </nav>

        <details class="plist" open>
          <summary class="label">{t.projects} · {projects.length}</summary>
          <ul>
            {
              projects.map((p) => (
                <li>
                  <a href={href(projectPath(lang, p.slug))} data-project={p.slug} class={`a-${p.accent}`}>
                    <i />
                    {p.client}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="ctas">
          <a class="btn btn-primary" href={cv} target="_blank" rel="noopener"><Icon name="download" size={16} />{t.cv}</a>
          <a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />{t.write}</a>
        </div>
      </aside>

      <main class="chat" id="chat">
        <div class="log" data-log role="log" aria-live="polite" aria-relevant="additions">
          <article class="msg bot intro">
            <div class="avatar sm" aria-hidden="true">FM</div>
            <div class="content">
              <h1>{greeting}</h1>
              <p class="lead">{profile.intro[lang]}</p>
              <div class="starters">
                {
                  starters.map((s) => (
                    <button type="button" data-ask={s} class={`a-${starterAccent[s]}`}>
                      <span class="ico">
                        <Icon name={starterIcon[s]} size={18} />
                      </span>
                      {replies[s].label[lang]}
                    </button>
                  ))
                }
              </div>
            </div>
          </article>
        </div>

        <div class="composer">
          <div class="chips" data-chips>
            {
              firstChips.map((c) => (
                <button type="button" data-ask={c}>
                  {replies[c].label[lang]}
                </button>
              ))
            }
          </div>
          <form data-form>
            <label for="ask" class="sr-only">{t.inputLabel}</label>
            <input id="ask" name="q" type="text" autocomplete="off" enterkeyhint="send" placeholder={t.placeholder} maxlength="300" />
            <button type="submit" aria-label={t.send}><Icon name="send" size={18} /></button>
          </form>
          <p class="note">{t.note}</p>
        </div>
      </main>

      <aside class="panel" data-panel hidden aria-label={t.projects}>
        <div class="panel-bar">
          <a data-panel-link href="#" class="ghost"><Icon name="external" size={16} /><span>{t.openPage}</span></a>
          <button type="button" class="ghost icon-only" data-close aria-label={t.close}><Icon name="x" size={18} /></button>
        </div>
        <div class="panel-body" data-panel-body></div>
      </aside>
    </div>
  </div>
</div>

<template id="t-bot">
  <article class="msg bot">
    <div class="avatar sm" aria-hidden="true">FM</div>
    <div class="content" data-body></div>
  </article>
</template>
<Blocks lang={lang} />
<script type="application/json" id="chat-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  import '../scripts/chat.ts';
</script>

<style is:global>
  .desk {
    height: 100dvh;
    padding: var(--space-6);
    display: grid;
  }
  .window {
    display: grid;
    grid-template-rows: auto 1fr;
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    min-height: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .lights {
    display: flex;
    gap: var(--space-2);
  }
  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .url {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: var(--space-1);
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .ghost:hover {
    background: var(--surface-2);
  }
  .icon-only {
    width: 40px;
    padding: 0;
    justify-content: center;
  }

  .body {
    display: grid;
    grid-template-columns: 272px minmax(0, 1fr) 0;
    min-height: 0;
    transition: grid-template-columns 0.35s var(--ease);
  }
  .has-panel .body {
    grid-template-columns: 272px minmax(0, 1fr) min(440px, 38vw);
  }
  /* Not enough room for three columns: the panel takes the sidebar's place. */
  @media (min-width: 900px) and (max-width: 1279px) {
    .has-panel .body {
      grid-template-columns: 0 minmax(0, 1fr) min(440px, 46vw);
    }
    .has-panel .sidebar {
      visibility: hidden;
      padding: 0;
      border: 0;
    }
  }

  /* Sidebar */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
    border-right: 1px solid var(--line);
    background: var(--surface-2);
    overflow-y: auto;
  }
  .me {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--lime);
    color: var(--on-accent);
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .avatar.sm {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-xs);
    font-size: var(--text-xs);
  }
  .name {
    font-weight: 600;
  }
  .muted {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }
  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(47 191 74 / 0.25);
  }
  .label {
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .menu {
    display: grid;
    gap: 2px;
  }
  .menu button {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 40px;
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    text-align: left;
    font-size: var(--text-sm);
  }
  .menu button:hover {
    background: var(--surface);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: var(--radius-xs);
    background: var(--accent);
    color: var(--on-accent);
  }
  .plist summary {
    cursor: pointer;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .plist ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .plist a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-xs);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .plist a:hover,
  .plist a[aria-current='true'] {
    background: var(--surface);
  }
  .plist a i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }
  .ctas {
    margin-top: auto;
    display: grid;
    gap: var(--space-2);
  }

  /* Chat */
  .chat {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
    min-width: 0;
  }
  .log {
    overflow-y: auto;
    padding: var(--space-10) max(var(--space-5), calc((100% - 760px) / 2)) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    scroll-padding-top: var(--space-5);
  }
  .msg {
    animation: rise 0.35s var(--ease) both;
  }
  .msg.user {
    align-self: flex-end;
    max-width: 80%;
    padding: var(--space-3) var(--space-4);
    border-radius: 20px 20px 6px 20px;
    background: var(--ink);
    color: var(--surface);
  }
  .msg.bot {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: var(--space-4);
  }
  .msg.bot .content > p {
    padding-top: var(--space-1);
  }
  .msg.typing .content::before {
    content: '';
    display: block;
    width: 36px;
    height: 34px;
    background: radial-gradient(circle, var(--muted) 3px, transparent 3.5px) 0 50% / 12px 12px repeat-x;
    animation: blink 1s steps(3) infinite;
    opacity: 0.6;
  }
  .intro h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    padding-top: 2px;
  }
  .intro .lead {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    max-width: 58ch;
    color: var(--muted);
  }
  .starters {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (min-width: 1180px) {
    .starters {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .starters button {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-align: left;
    font-weight: 500;
    transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .starters button:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .starters .ico {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
  }

  .composer {
    padding: 0 max(var(--space-5), calc((100% - 760px) / 2)) var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .chips {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px;
  }
  .chips button {
    flex: none;
    min-height: 36px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-size: var(--text-sm);
    animation: rise 0.3s var(--ease) both;
  }
  .chips button:hover {
    background: var(--surface-2);
  }
  form[data-form] {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface);
    box-shadow: 0 8px 24px -16px rgb(0 0 0 / 0.3);
  }
  form[data-form]:focus-within {
    border-color: var(--ink);
  }
  form[data-form] input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    font-size: var(--text-md);
    outline: none;
  }
  form[data-form] button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--surface);
  }
  .note {
    text-align: center;
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  /* Side panel */
  .panel {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    min-width: 0;
    border-left: 1px solid var(--line);
    background: var(--surface);
  }
  .panel[hidden] {
    display: none;
  }
  .panel-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .panel-body {
    overflow-y: auto;
    padding: var(--space-5);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes blink {
    from {
      width: 12px;
    }
    to {
      width: 48px;
    }
  }

  @media (max-width: 899px) {
    .desk {
      padding: 0;
    }
    .window {
      border-radius: 0;
      border: 0;
    }
    .lights,
    .url {
      display: none;
    }
    .titlebar {
      order: 0;
    }
    .body,
    .has-panel .body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
    .sidebar {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      border-right: 0;
      border-bottom: 1px solid var(--line);
      overflow: visible;
    }
    .sidebar .avatar {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
    }
    .status,
    .menu,
    .plist {
      display: none;
    }
    .ctas {
      margin: 0 0 0 auto;
      display: flex;
    }
    .ctas .btn {
      min-height: 40px;
      padding: 0 var(--space-3);
      font-size: var(--text-sm);
    }
    .ctas .btn:last-child {
      display: none;
    }
    .log {
      padding: var(--space-6) var(--space-4) var(--space-4);
    }
    .composer {
      padding: 0 var(--space-4) var(--space-3);
    }
    .panel {
      position: fixed;
      inset: 0;
      z-index: 20;
      border: 0;
      animation: rise 0.3s var(--ease) both;
    }
  }
  @media (max-width: 520px) {
    .titlebar .ghost span {
      display: none;
    }
    .me .muted {
      display: none;
    }
    .msg.bot {
      grid-template-columns: minmax(0, 1fr);
    }
    .msg.bot > .avatar {
      display: none;
    }
  }
</style>
