---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import type { Lang } from '../data/profile.ts';
import { profile, experience, education } from '../data/profile.ts';
import { href } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // this page, e.g. /progetti/gse/
  altPath: string; // same page in the other language
}
const { lang, title, description, path, altPath } = Astro.props;
const abs = (p: string) => new URL(href(p), Astro.site).href;
const other: Lang = lang === 'it' ? 'en' : 'it';
const itPath = lang === 'it' ? path : altPath;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role[lang],
  url: abs(lang === 'it' ? '/' : '/en/'),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Roma', addressCountry: 'IT' },
  worksFor: { '@type': 'Organization', name: experience[0].company },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsLanguage: ['it', 'en'],
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(path)} />
    <link rel="alternate" hreflang={lang} href={abs(path)} />
    <link rel="alternate" hreflang={other} href={abs(altPath)} />
    <link rel="alternate" hreflang="x-default" href={abs(itPath)} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#e9e7e1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <slot />
  </body>
</html>
